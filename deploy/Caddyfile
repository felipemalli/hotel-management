# {$DOMAIN::80} = HTTP em qualquer Host (smoke local / IP do EC2).
# Hostname sem esquema (hotel.exemplo.com) = HTTPS automatico, Let's Encrypt.
{$DOMAIN::80} {
	encode gzip zstd

	handle /api* {
		reverse_proxy backend:8000
	}

	# Sidecar do Swagger (WhiteNoise). O SPA do Vite usa /assets/, nao /static/.
	handle /static* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}

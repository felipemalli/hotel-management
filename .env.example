# ---------------------------------------------------------------------------
# Copie para .env antes de subir:  cp .env.example .env
# Gere as duas chaves abaixo (nunca use os placeholders em producao):
#   FIELD_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   HASH_PEPPER:          python -c "import secrets; print(secrets.token_hex(32))"
#   SECRET_KEY:           python -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------------

# --- Django ---
# Vazia de proposito: com DEBUG=0 o processo recusa subir sem ela, em vez de
# assinar JWT com um valor publico. Gere a sua (comando no topo do arquivo).
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Criptografia de PII em repouso (SPEC 2.1) ---
# Fernet, 32 bytes em base64 url-safe. Perder esta chave = perder documento/telefone.
# Aceita LISTA separada por virgula para rotacao: a primeira cifra, as demais
# apenas decifram. Girar a chave sem passar pela lista cega a base inteira.
#   1) FIELD_ENCRYPTION_KEY="<nova>,<antiga>"
#   2) docker compose exec backend uv run python manage.py rotate_pii
#   3) FIELD_ENCRYPTION_KEY="<nova>"
FIELD_ENCRYPTION_KEY=
# Pepper do blind index (HMAC-SHA256). Trocar invalida toda busca exata
# existente -- `rotate_pii` re-deriva os hashes e a restaura.
HASH_PEPPER=

# --- PostgreSQL ---
POSTGRES_DB=hotel
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
# Dentro do compose o backend recebe DB_HOST=db. Fora do compose (execucao
# hibrida do README) o default localhost e o correto.
DB_HOST=localhost
DB_PORT=5432
# Porta publicada no host pelo servico db. Troque se 5432 ja estiver em uso
# na sua maquina (e ajuste DB_PORT junto, para a execucao hibrida).
DB_PORT_HOST=5432

# --- Ajuste fino (todas opcionais, defaults sensatos) ---
# Workers do gunicorn no compose. Com 1 worker sync, uma chamada de IA (que faz
# HTTP para fora, com timeout de 10s) congela a API inteira.
GUNICORN_WORKERS=3
# Limites de taxa. O login e anonimo e alvo de forca bruta; /api/ai/ gasta
# credito de provedor externo por chamada. Formato do DRF: "N/segundo|minuto|hora|dia".
THROTTLE_LOGIN=10/min
THROTTLE_AI=20/min

# --- IA opcional (SPEC 7) ---
# Sem esta chave, /api/ai/status/ responde enabled: false e a suite segue verde.
# Atencao: com a chave setada, texto livre do formulario e enviado a um
# provedor externo (Anthropic) para extracao de campos.
ANTHROPIC_API_KEY=

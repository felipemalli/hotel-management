# ---------------------------------------------------------------------------
# Copie para .env antes de subir:  cp .env.example .env
# Gere a SECRET_KEY (nunca use um placeholder em producao):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------------

# --- Django ---
# Vazia de proposito: com DEBUG=0 o processo recusa subir sem ela, em vez de
# assinar JWT com um valor publico. Gere a sua (comando no topo do arquivo).
SECRET_KEY=
DEBUG=0
# Flag `Secure` dos cookies (sessao, csrftoken e refresh). Sobre http so Chromium e
# Firefox a aceitam, e so em localhost: no resto o cookie some e o login nao pega.
# Por isso 0 na demo; atras de TLS, 1.
COOKIE_SECURE=0
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL ---
POSTGRES_DB=hotel
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
# Dentro do compose o backend recebe DB_HOST=db. Fora do compose (execucao
# hibrida do README) o default localhost e o correto.
DB_HOST=localhost
DB_PORT=5432
# Porta publicada no host pelo servico db. Troque se 5432 ja estiver em uso
# na sua maquina (e ajuste DB_PORT junto, para a execucao hibrida).
DB_PORT_HOST=5432

# --- Cache (opcional) ---
# Vazia de proposito. O compose injeta REDIS_URL=redis://redis:6379/1 no
# servico backend, e ai o cache do throttle do DRF vai para o Redis. Sem ela
# (execucao nativa ou hibrida do README) o cache cai no proprio Postgres, via
# tabela criada pelo `createcachetable` -- nenhum requisito depende do Redis.
REDIS_URL=

# --- Ajuste fino (todas opcionais, defaults sensatos) ---
# Workers do gunicorn no compose. Com 1 worker sync, uma pergunta a Iris (que
# faz varias chamadas HTTP para fora, com orcamento de 15s no total) congela a
# API inteira.
GUNICORN_WORKERS=3
# Limites de taxa. O login e anonimo e alvo de forca bruta; /api/ai/ gasta
# credito de provedor externo por chamada. Formato do DRF: "N/segundo|minuto|hora|dia".
THROTTLE_LOGIN=10/min
# O boot do frontend renova a sessao pelo cookie a cada carga de pagina, entao o
# refresh nao pode dividir a franquia do login. O balcao divide um IP atras do NAT.
THROTTLE_REFRESH=60/min
THROTTLE_AI=20/min

# --- IA opcional: a Iris, copiloto do hotel ---
# Sem a chave, /api/ai/status/ responde enabled: false, a pagina /iris mostra a
# Iris desligada e a suite segue verde.
#
# OPENAI_API_KEY: chave da plataforma da OpenAI (platform.openai.com). Uma
# pergunta gasta de 2 a 7 chamadas, entao confira os limites de taxa da sua
# conta antes de uma demonstracao ao vivo.
OPENAI_API_KEY=
# OPENAI_MODEL: opcional; confira o default em backend/ai/config.py.
#
# O que sai para o provedor: nomes (titular e acompanhantes), quartos, datas, o
# extrato projetado e agregados de faturamento. Documento e telefone nunca saem,
# nada entra em log, e o request pede store: false.
